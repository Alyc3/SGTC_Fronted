# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/deepfake_db

# Celery & Redis Configuration
REDIS_URL=redis://redis:6379/0

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
MAX_VIDEO_SIZE_BYTES=524288000
UPLOAD_DIR=/app/uploads

# Hugging Face Model Settings (LipFD)
HF_MODEL_REPO=Alyce12/LipFD
MODEL_FILE_NAME=LipFD.pt
HF_TOKEN=your_huggingface_token_here
LOCAL_MODEL_PATH=/app/models/LipFD.pt
