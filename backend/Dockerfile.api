FROM python:3.11-slim

# Install system dependencies (ffmpeg and build essentials)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy python packages list
COPY requirements.txt .

# Pre-install CPU version of PyTorch to speed up container build and run on CPU-only hosts
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install remaining python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy all project code into the container
COPY . .

# Expose FastAPI default port
EXPOSE 8000

# Execute the entry point script
CMD ["python", "app/main.py"]
